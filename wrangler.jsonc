{
  "name": "soddrop",
  "main": "worker/party.js",
  "compatibility_date": "2025-06-01",

  // Serves index.html and the audio folder straight from this directory.
  // Requests that are not static files (like /party/ABCDE/ws) go to the Worker.
  "assets": {
    "directory": ".",
    // WebSocket rooms always go to the Worker, never the asset server.
    "run_worker_first": ["/party/*"]
  },

  "durable_objects": {
    "bindings": [
      { "name": "PARTY", "class_name": "PartyRoom" }
    ]
  },

  // SQLite-backed classes work on the Workers Free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PartyRoom"] }
  ]
}
